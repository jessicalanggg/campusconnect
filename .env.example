# Copy to .env and replace with a long random secret before starting.
SECRET_KEY=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# Comma-separated accounts that can add exam dates and run matching rounds.
ADMIN_EMAILS=you@upenn.edu
# Optional: limit sign-up to a school and require an emailed confirmation link.
# ALLOWED_EMAIL_DOMAINS=upenn.edu
# REQUIRE_EMAIL_VERIFICATION=true
# SMTP for confirmation emails. Without it, links are printed in the backend log.
# SMTP_HOST=smtp.gmail.com
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=your-app-password
# EMAIL_FROM=CampusConnect <you@gmail.com>
